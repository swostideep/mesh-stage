# Copy to .env for local development. Every value below has a default, so the
# API also starts with no .env at all: it falls back to an in-process queue and
# an in-memory store, which is enough to exercise the whole pipeline locally.

# Required in production. Omitted in development, where an ephemeral secret is
# generated at startup instead.
JWT_SECRET=

# Persistent storage. Without it the API refuses to start when NODE_ENV is
# production, and uses the in-memory store otherwise.
MONGODB_URI=

# Durable queue. Without it the API uses an in-process FIFO, which is fine for
# a single container but loses queued work on restart.
REDIS_URL=

# Comma-separated allowlist. Empty reflects any origin, which is a development
# convenience and should be set for a real deployment.
SM_CORS_ORIGINS=

GOOGLE_CLIENT_ID=

# Engine budget. Two threads and one concurrent job match the two vCPUs a free
# Hugging Face Space provides; raising either oversubscribes the container.
SM_THREADS=2
SM_CONCURRENCY=1
SM_MAX_ELEMENTS=1500000
SM_ENGINE_TIMEOUT_MS=240000

# Upload limits and retention on an ephemeral disk.
SM_MAX_UPLOAD_BYTES=41943040
SM_RETENTION_MS=21600000

PORT=7860
NODE_ENV=development
SM_LOG_LEVEL=info
